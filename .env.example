# Copy to .env and fill in values. Do NOT commit .env.

# Needed only to regenerate the training data (finetuning/generate_data.py).
# Not needed at runtime.
ANTHROPIC_API_KEY=sk-ant-...

# Shared secret between the gateway and vLLM. Any string; defaults to a dev
# placeholder if left empty.
VLLM_API_KEY=dev-secret-abc

# Grafana admin login. Defaults to admin/admin if left empty.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
